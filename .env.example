# Token Factory inference (OpenAI-compatible). Confirm the base URL in your console;
# some accounts are served from a regional host such as
# https://api.tokenfactory.us-central1.nebius.com/v1/
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Sandboxes (contree-sdk IAMAuth reads these two names directly)
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
# (the Sandboxes CLI calls the same value NEBIUS_AI_PROJECT; either name works here)

# Backend for the checkpoint tree: "contree" (real) or "local" (stand-in for dev/tests)
GF_SANDBOX_BACKEND=local

# Optional
TAVILY_API_KEY=
GF_MAX_CONCURRENCY=40

# --- No card yet? Development-only fallback (NOT valid for the submission) ---
# Free key, no card: https://build.nvidia.com -> sign in -> get an API key (starts with nvapi-)
# GF_LLM_PROVIDER=nvidia-dev
# NVIDIA_API_KEY=
# Model IDs differ there; run scripts/check_env.py and set any that are missing, e.g.
# GF_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
