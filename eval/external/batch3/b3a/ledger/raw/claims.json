  {
    "id": "C81",
    "figure_or_table": null,
    "metric": "Ncut affinity matrix construction",
    "unit": "nearest neighbors",
    "reported_value": 20.0,
    "conditions": {
      "method": "Fair Ncut",
      "affinity": "20-nearest neighbor",
      "weight": "1 if within 20-NN else 0"
    },
    "type": "absolute",
    "page": 5,
    "quote": "For Ncut, we use 20-nearest neighbor affinity matrix, W: w(x_p, x_q) = 1 if data point x_q is within the 20-nearest neighbors of x_p, and equal to 0 otherwise.",
    "headline": false
  },
  {
    "id": "C82",
    "figure_or_table": null,
    "metric": "overall clustering balance definition",
    "unit": "balance measure",
    "reported_value": null,
    "conditions": {
      "metric": "balance = min_Sk balance(Sk)",
      "fairness": "cluster balance per Eq. (1)"
    },
    "type": "absolute",
    "page": 5,
    "quote": "We evaluate the results in terms of the balance of each cluster Sk in (1), and define the overall balance of the clustering as balance = min_Sk balance(Sk).",
    "headline": false
  },
  {
    "id": "C83",
    "figure_or_table": null,
    "metric": "fairness error definition",
    "unit": "KL divergence",
    "reported_value": null,
    "conditions": {
      "metric": "fairness error = D_KL(U||P_k)",
      "zero_condition": "when proportions match target distribution"
    },
    "type": "absolute",
    "page": 5,
    "quote": "We further propose to evaluate the fairness error, which is the KL divergence D_KL(U||P_k) in (2). This KL measure becomes equal to zero when the proportions of the demographic groups within all the output clusters match the target distribution.",
    "headline": false
  },
  {
    "id": "C84",
    "figure_or_table": null,
    "metric": "variational method achieves small fairness errors with better clustering objectives",
    "unit": "comparison",
    "reported_value": null,
    "conditions": {
      "method": "variational fair clustering",
      "comparison": "state-of-the-art fair-clustering methods",
      "datasets": "all datasets"
    },
    "type": "trend",
    "page": 5,
    "quote": "As discussed in more details below (Tables 2, 3 and 4), our variational formulation can achieve small fairness errors (competitive with the existing state-of-the-art fair-clustering methods), but with much better clustering objectives, consistently across all the data sets.",
    "headline": true
  },
  {
    "id": "C85",
    "figure_or_table": null,
    "metric": "Backurs et al. 2019 not applicable for J>2",
