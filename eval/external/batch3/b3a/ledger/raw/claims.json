[
  {
    "id": "C1",
    "figure_or_table": null,
    "metric": "fairness and clustering objective competitiveness",
    "unit": null,
    "reported_value": null,
    "conditions": {
      "method": "variational fair clustering",
      "comparison": "state-of-the-art methods",
      "benchmarks": "various fair-clustering benchmarks"
    },
    "type": "trend",
    "page": 1,
    "quote": "We report comprehensive evaluations and comparisons with state-of-the-art methods over various fair-clustering benchmarks, which show that our variational formulation can yield highly competitive solutions in terms of fairness and clustering objectives.",
    "headline": true
  },
  {
    "id": "C2",
    "figure_or_table": null,
    "metric": "scalability enables trade-off exploration",
    "unit": null,
    "reported_value": null,
    "conditions": {
      "method": "variational fair clustering",
      "aspect": "distributed updates for large-scale datasets"
    },
    "type": "trend",
    "page": 1,
    "quote": "This scalability is important as it enables to explore different trade-off levels between the fairness and clustering objectives.",
    "headline": true
  },
  {
    "id": "C3",
    "figure_or_table": null,
    "metric": "eigenvalue decomposition requirement",
    "unit": null,
    "reported_value": null,
    "conditions": {
      "method": "variational fair clustering",
      "comparison": "spectral relaxation (Kleindessner et al. 2019)"
    },
    "type": "absolute",
    "page": 1,
    "quote": "Unlike spectral relaxation, our formulation does not require computing its eigenvalue decomposition.",
    "headline": true
  },
  {
    "id": "C4",
    "figure_or_table": null,
    "metric": "trade-off control capability",
    "unit": null,
    "reported_value": null,
    "conditions": {
      "method": "variational multi-term approach",
      "comparison": "existing combinatorial and spectral solutions"
    },
    "type": "trend",
    "page": 2,
    "quote": "Fundamentally different from the existing combinatorial and spectral solutions, our variational multi-term approach enables to control the trade-off levels between the fairness and clustering objectives.",
    "headline": true
  },
  {
    "id": "C5",
    "figure_or_table": null,
    "metric": "scalable solution with convergence guarantee",
    "unit": null,
    "reported_value": null,
    "conditions": {
      "method": "variational fair clustering",
      "optimization": "joint optimization of tight upper bound with clustering objectives"
    },
    "type": "trend",
    "page": 2,
    "quote": "Our tight upper bound can be jointly optimized with various clustering objectives, while yielding a scalable solution, with convergence guarantee.",
    "headline": true
  },
  {
    "id": "C6",
    "figure_or_table": null,
    "metric": "independent per-assignment-variable updates",
    "unit": null,
    "reported_value": null,
    "conditions": {
      "method": "variational fair-clustering algorithm",
      "iteration": "each iteration"
    },
    "type": "absolute",
    "page": 2,
    "quote": "at each iteration, our general variational fair-clustering algorithm performs an independent update for each assignment variable. Therefore, it can easily be distributed for large-scale datasets.",
    "headline": true
  },
  {
